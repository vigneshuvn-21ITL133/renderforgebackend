# Copy to .env. Every key uses the RF_ prefix.

# Neon: Console -> your project -> Connect. Paste the connection string as it is
# (pooled or direct, with ?sslmode=require&channel_binding=require). The app converts it for asyncpg.
RF_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Use Alembic for the schema on Neon: run `alembic upgrade head` once, then keep this false.
RF_CREATE_TABLES_ON_STARTUP=false

RF_JWT_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters
RF_INFERENCE_BASE_URL=http://localhost:8001
RF_INFERENCE_API_KEY=same-value-as-the-inference-service-key
RF_ALLOWED_ORIGINS=["http://localhost:3000"]
