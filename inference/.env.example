# Copy to .env and adjust as needed. All vars are prefixed RF_.

RF_HOST=0.0.0.0
RF_PORT=8001

# Shared secret the backend must send as X-API-Key. Leave unset to disable.
RF_API_KEY=change-me

# Which model to load (one per process, VRAM): triposr | hunyuan3d_mini
RF_ENGINE=triposr

# cuda | cpu | auto (auto picks cuda if available)
RF_DEVICE=auto

# TripoSR: lower this (e.g. 4096 or 2048) if you hit CUDA out-of-memory
RF_MODEL_CHUNK_SIZE=8192

# Hunyuan3D-2mini only: lower = less VRAM but slower (upstream example uses 20000)
RF_HUNYUAN_NUM_CHUNKS=8000

RF_MAX_UPLOAD_MB=10
RF_ENABLE_MESH_CLEANUP=true
RF_ENABLE_DECIMATION=true
RF_DECIMATION_TARGET_FACES=20000

# --- Mesh quality (all optional) ---
# Taubin smoothing passes to remove marching-cubes bumps. 0 turns it off.
RF_SMOOTH_ITERATIONS=10
# Drop floating pieces smaller than this share of the main piece.
RF_MIN_COMPONENT_RATIO=0.03
# TripoSR iso-surface level. Lower = fuller/thicker shape, higher = thinner. Try 15 to 35.
RF_MC_THRESHOLD=25
# Background remover. "isnet-general-use" often cuts cleaner edges (downloads a model on first use).
RF_REMBG_MODEL=u2net
